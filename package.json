{
  "name": "@eag/enterprise-agent-governance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "description": "Enterprise Agent Governance — Pi-based coding agent with policy enforcement, audit, and swarm mode",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run desktop:build",
    "desktop:build:main": "node scripts/build-main.mjs",
    "desktop:build:renderer": "cd src/desktop/renderer && vite build",
    "desktop:build": "npm run desktop:build:main && npm run desktop:build:renderer",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:dev": "npm run dev",
    "desktop:dev:server": "node node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "dev:api": "node node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "dev:ui": "vite --config src/desktop/renderer/vite.config.ts",
    "dev": "node scripts/dev.mjs",
    "desktop:package": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "cors": "^2.8.6",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.2.1",
    "globals": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "zustand": "^5.0.0"
  }
}
