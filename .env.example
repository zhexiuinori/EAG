# 复制为 .env 后填入真实值。该文件已被 .gitignore 忽略，切勿提交。

# Provider 密钥（对应 config.json 中的 ${...} 占位符）
EAG_API_KEY_CLAUDE_ROUTER=
EAG_API_KEY_OPENAI=
EAG_API_KEY_DEEPSEEK=
# 本地自定义 Provider（config.json 中 prov_1788855685795 / prov_1789361990499 / prov_local_anthropic）
EAG_API_KEY_TEST=
EAG_API_KEY_LOCAL=

# 治理：允许的出网端点白名单（逗号分隔）。留空 = 不启用出网管控。
EAG_ALLOWED_ENDPOINTS=http://localhost:11434

# 出网白名单强制开关：1 = 命中非白名单端点时直接阻断（抛错）；0 = 仅告警。
EAG_EGRESS_ENFORCE=0

# 审计目录（留空则使用 <项目根>/audit）
EAG_AUDIT_DIR=
